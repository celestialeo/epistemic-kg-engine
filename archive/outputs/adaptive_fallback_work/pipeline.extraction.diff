+def reference_sentences(unit, context):
+    """Earlier verbatim sentences with source offsets; no look-ahead or inferred text."""
+    sentences = []
+    for passage in context.get('reference_paragraphs', [context]):
+        before = passage['text'][:max(0, unit['start'] - passage['start'])].rstrip()
+        boundaries = [0, *[m.end() for m in re.finditer(r'(?<=[.!?])\s+(?=\S)', before)], len(before)]
+        for left, right in zip(boundaries, boundaries[1:]):
+            raw = before[left:right]
+            text = raw.strip()
+            if text and re.search(r'[.!?]$', text):
+                start = passage['start'] + left + len(raw) - len(raw.lstrip())
+                sentences.append(dict(text=text, start=start, end=start + len(text)))
+    return sentences
+
