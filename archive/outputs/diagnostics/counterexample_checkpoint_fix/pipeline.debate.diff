+def validate_counterexample_review(review, models, entity_id):
+    """Check each explanation without showing its flag or reassessing factual truth.
+
+    This runs inside the applicability request's validator, so missing or
+    contradictory explanations retry that reviewer under the existing budget.
+    No extracted conclusion can silently replace a reviewer's decision.
+    """
+    reasons = dict(case_is_supported=review.case_reason, refutes_exact_assertion=review.refutation_reason)
+
+    def check_quotes(audit):
+        for name, reason in reasons.items():
+            finding = getattr(audit, name)
+            for quote in (finding.conclusion_quote, finding.justification_quote):
+                if quote is not None and (not quote.strip() or quote not in reason):
+                    raise ValueError('Use an exact contiguous quote from this decision\'s own explanation')
+            if finding.conclusion != 'not_stated' and not finding.conclusion_quote:
+                raise ValueError('A stated conclusion requires an exact quote')
+
